% State Space Representation
a = Jr + Mp*Lr^2;
b = 0.5*Mp*Lp*Lr;
c = Jp + 0.25*Mp*Lp^2;
d = 0.5*Mp*Lp*g;

Delta = a*c - b^2;

A = [ 0,          0,              1,                0;
      0,          0,              0,                1;
      0,      b*d/Delta,     -c*Br/Delta,     -b*Bp/Delta;
      0,      a*d/Delta,     -b*Br/Delta,     -a*Bp/Delta ];

B = [ 0;
      0;
      c/Delta;
      b/Delta ];

C = eye(2,4);
D = zeros(2,1);

% Add actuator dynamics
A(3,3) = A(3,3) - Kg^2*kt*km/Rm * B(3);
A(4,3) = A(4,3) - Kg^2*kt*km/Rm * B(4);
B = Kg*kt*B/Rm;

system = ss(A,B,C,D);